{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/rca/stage-action.input.schema.json",
  "title": "RCA hosted stage action input",
  "type": "object",
  "required": [
    "workspace_root",
    "project_id"
  ],
  "properties": {
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Exact visual work-item identity in the authorized workspace_index.json; Framework resolves its project root."
    },
    "source_truth_refs": {
      "type": "object",
      "description": "Optional prevalidated source-truth locators. OPL validates bytes, currentness, and StageRun binding; RCA interprets the referenced readiness semantics.",
      "required": [
        "manifest_ref",
        "readiness_ref",
        "source_package_digest_ref"
      ],
      "properties": {
        "manifest_ref": {
          "type": "string",
          "minLength": 1
        },
        "readiness_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_package_digest_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
