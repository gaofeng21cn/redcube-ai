{
  "schema_version": "opl_carrier_projection.v1",
  "owner": "rca",
  "carrier_root": "plugins/redcube-ai",
  "resource_source_mode": "git_tracked",
  "resource_roots": [
    "agent",
    "contracts",
    "python",
    "runtime",
    "docs",
    "prompts/ppt_deck"
  ],
  "exclude_basename_prefixes": [
    "test_"
  ],
  "extra_files": [
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "assets/branding/redcube-ai-logo.png",
    "assets/branding/redcube-ai-overview-v3.png",
    "app-contribution-adapter.json"
  ],
  "file_aliases": [
    {
      "from": "assets/branding/redcube-ai-logo.png",
      "to": "assets/icon.png"
    },
    {
      "from": "agent/primary_skill/SKILL.md",
      "to": "skills/redcube-ai/SKILL.md"
    }
  ],
  "version_sync_checks": {
    "manifest_path": "contracts/opl_agent_package_manifest.json",
    "update_bundled_required_skill_pack_version": true
  },
  "package_manifest_projection": {
    "mode": "pick_keys",
    "pick_keys": [
      "surface_kind",
      "agent_id",
      "package_id",
      "display_name",
      "presentation",
      "publisher",
      "version",
      "source",
      "carrier_source_role",
      "source_repo",
      "schema_ref",
      "domain_descriptor_ref",
      "entrypoints",
      "app_contributions"
    ],
    "codex_surface_pick_keys": [
      "plugin_id",
      "configured_codex_plugin_carrier",
      "required_skill_ids",
      "app_contribution_abi",
      "app_contribution_adapter"
    ],
    "codex_surface_plugin_source_dot": true,
    "domain_id_from_domain_descriptor": true,
    "task_provider_suffix_from_domain_descriptor": "#/standard_agent_interface/stage_catalog",
    "strip_entrypoint_carrier_prefix": "plugins/redcube-ai",
    "override_fields": {
      "kind": "agent",
      "action_catalog_ref": "contracts/action_catalog.json",
      "view_refs": [],
      "requires": [],
      "capability_dependencies": []
    },
    "sync_root_opl_package": {
      "source": "contracts/opl_agent_package_manifest.json",
      "target": "opl-package.json"
    }
  },
  "plugin_manifests": [
    {
      "path": ".codex-plugin/plugin.json",
      "sync_version": true
    },
    {
      "path": "plugins/redcube-ai/.codex-plugin/plugin.json",
      "sync_version": true
    },
    {
      "path": "plugins/redcube-ai/plugin.json",
      "sync_version": true
    }
  ]
}
