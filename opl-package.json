{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "rca",
    "version": "0.3.6",
    "intent": "agent",
    "name": {
      "zh-CN": "RedCube AI",
      "en-US": "RedCube AI"
    },
    "summary": {
      "zh-CN": "以图像为核心的视觉内容设计、生成、评审与交付。",
      "en-US": "Image-first visual content design, generation, review, and delivery."
    },
    "description": {
      "zh-CN": "以图像为核心的视觉内容设计、生成、评审与交付，面向 OPL 托管 StageRun 与 Codex 协同执行。",
      "en-US": "Image-first visual content design, generation, review, and delivery through OPL-generated interfaces and hosted StageRun."
    },
    "publisher": "one-person-lab",
    "license": "Apache-2.0",
    "icon": "assets/branding/redcube-ai-logo.png",
    "repository": "https://github.com/gaofeng21cn/redcube-ai",
    "homepage": "https://github.com/gaofeng21cn/redcube-ai",
    "maturity": "stable",
    "keywords": [
      "redcube",
      "codex",
      "visual-deliverables",
      "gateway"
    ],
    "routing_summary": {
      "zh-CN": "以图像为核心的视觉内容设计、生成、评审与交付。",
      "en-US": "Run the RCA visual-deliverable stages through the OPL-hosted StageRun controller while preserving RCA visual truth and review/export authority."
    },
    "default_prompts": [
      "Use the installed redcube-ai skill through OPL-generated interfaces.",
      "Start or continue the hosted RCA StageRun for this visual deliverable."
    ],
    "home_shortcuts": [
      {
        "id": "invoke_product_entry",
        "label": {
          "zh-CN": "制作视觉交付物",
          "en-US": "Create or continue a visual deliverable"
        },
        "default_visible": true,
        "target": {
          "kind": "agent",
          "ref": "rca"
        }
      }
    ]
  },
  "dependencies": {
    "opl_base": "^2.0.0",
    "runtimes": [
      {
        "name": "python",
        "version": ">=3.12",
        "optional": false
      },
      {
        "name": "node",
        "version": ">=22",
        "optional": false
      }
    ]
  },
  "permissions": {
    "workspace": {
      "access": "read_write",
      "reason": {
        "zh-CN": "读取视觉素材并写入幻灯片、图文与导出交付物",
        "en-US": "Read visual source materials and write slides, graphics, and export deliverables"
      }
    },
    "knowledge": [
      {
        "scope": "project_local",
        "access": "read",
        "required": false,
        "reason": {
          "zh-CN": "按需引用项目视觉素材与品牌规范",
          "en-US": "Reference project visual sources and brand guidelines on demand"
        }
      }
    ],
    "network": "outbound_api",
    "execution_mode": "local_subprocess"
  },
  "provides": {
    "agent": {
      "stages_ref": "agent/stages/manifest.json"
    },
    "skills": [
      {
        "id": "redcube-ai",
        "path": "./agent/primary_skill",
        "exposure": "default"
      }
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "node",
        "./agent/tools/app-contribution.mjs"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "rca.workspace.status",
          "view_type": "list_detail",
          "slot": "runtime.detail",
          "title": {
            "zh-CN": "视觉项目阶段",
            "en-US": "Visual project status"
          },
          "data_ref": "rca.workspace.v1#status",
          "empty_state": {
            "zh-CN": "选择当前工作区中的视觉任务，查看阶段与下一步",
            "en-US": "Select a visual task in the current workspace to inspect progress and next actions"
          }
        },
        {
          "id": "rca.workspace.artifacts",
          "view_type": "list_detail",
          "slot": "runtime.detail",
          "title": {
            "zh-CN": "视觉交付物",
            "en-US": "Visual deliverables"
          },
          "data_ref": "rca.workspace.v1#artifacts",
          "empty_state": {
            "zh-CN": "选择视觉任务，查看已登记的产物与证据",
            "en-US": "Select a visual task to inspect its registered artifacts and evidence"
          }
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/rca",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": true,
      "plugin_name": "redcube-ai",
      "category": "Creative",
      "brand_color": "#C65D2E",
      "capabilities": [
        "Interactive",
        "Write"
      ]
    }
  }
}
